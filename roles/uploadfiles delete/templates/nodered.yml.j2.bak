name: nodered

services:
  nodered:
    image: alex/nodered:base
    pull_policy: never
    environment:
      - TZ=Europe/Amsterdam
    ports:
      - "1880:1880"
    networks:
      - nodered-net
    volumes:
      - type: bind
        source: /{{ prop_basename }}/nodered/data
        target: /data
      - type: bind
        source: /mnt/data-{{ prop_cmdb.environment }}/nodered/{{ prop_host.hostname }}/backup
        target: /backup
      - type: bind
        source: /{{ prop_basename }}/bashpipe/{{ prop_basename }}pipe
        target: /{{ prop_basename }}pipe
    restart: unless-stopped

networks:
  nodered-net:

